<!--
Generated by cargo-about from Cargo.lock. Do not edit THIRD_PARTY_NOTICES.html
directly; update about.toml or this template and regenerate it instead.
-->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Semafuse third-party notices</title>
  <style>
    body { color: #1f2937; font: 16px/1.5 system-ui, sans-serif; margin: 0; }
    main { margin: 0 auto; max-width: 900px; padding: 2rem; }
    a { color: #075985; }
    .license { border-top: 1px solid #d1d5db; margin-top: 2rem; padding-top: 1rem; }
    .used-by { columns: 2; }
    pre { background: #f3f4f6; overflow: auto; padding: 1rem; white-space: pre-wrap; }
    @media (max-width: 640px) { .used-by { columns: 1; } }
  </style>
</head>
<body>
<main>
  <h1>Semafuse third-party notices</h1>
  <p>
    This document lists licenses for Rust dependencies included by the release
    feature union across the five supported release targets.
  </p>

  <h2>License overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>

  {{#each licenses}}
  <section class="license">
    {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
    <h3>{{name}}</h3>
    <p>Used by:</p>
    <ul class="used-by">
      {{#each used_by}}
      <li>
        <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">
          {{crate.name}} {{crate.version}}
        </a>
      </li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</main>
</body>
</html>
